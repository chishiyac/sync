{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "source/env.d.ts",
    "source/**/*",
    "source/**/*.tsx",
    "electron/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "paths": {
      // For source
      "@/*": [
        "./source/*"
      ]
    },
    "strictNullChecks": true
  }
}