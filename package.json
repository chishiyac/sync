{
  "name": "software",
  "version": "1.0.0",
  "description": "A fast and intuitive Git HUD UI for modern developers.",
  "keywords": [
    "desktop",
    "developer-tools",
    "frontend",
    "git",
    "hud",
    "workflow"
  ],
  "homepage": "https://github.com/chishiyac/sync#readme",
  "bugs": {
    "url": "https://github.com/chishiyac/sync/issues"
  },
  "license": "MIT",
  "author": "chishiyac (letmat.contact@gmail.com)",
  "contributors": [
    {
      "email": "letmat.contact@gmail.com",
      "name": "chishiyac",
      "url": "https://github.com/chishiyac"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chishiyac/sync.git"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "fmt:check": "ultracite check",
    "fmt:lint": "ultracite fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.32",
    "electron-updater": "^6.3.9",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "recharts": "^3.10.1",
    "shadcn": "^4.19.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-sonarjs": "^4.2.0",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "ultracite": "7.10.7",
    "vite": "^7.2.6"
  },
  "badges": [
    "https://img.shields.io/badge/Git-HUD-blue",
    "https://img.shields.io/badge/frontend-desktop-111827"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.26.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "productName": "Sync",
  "readme": "README.md"
}
